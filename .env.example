# ============================================================
# KODEXA CRM — Environment Variables
# Copiar a .env.local y completar. NUNCA commitear .env.local.
# ============================================================

# Misma base Supabase que usa Nexo — NO crear un proyecto Supabase nuevo.
# Pedir estos dos valores a quien tenga acceso al proyecto (son los mismos
# que están en nexo/.env.local, ver docs/architecture/crm-fase2-bootstrap.md
# sección E).
DATABASE_URL=
DIRECT_URL=

# DEBE ser exactamente el mismo valor que BETTER_AUTH_SECRET en
# nexo/.env.local — es lo que hace que la identidad (User/Session/Account)
# sea compartida entre Nexo y CRM. Nunca generar uno nuevo para este
# proyecto.
BETTER_AUTH_SECRET=
# URL de referencia de esta app. En dev el puerto real puede terminar
# siendo 3000 o 3001 según qué otra cosa esté corriendo (Nexo suele tomar
# el 3000 primero) — lib/auth/auth.ts ya confía en ambos puertos
# explícitamente (trustedOrigins), así que este valor no tiene que
# coincidir exactamente con el puerto en el que terminó arrancando.
BETTER_AUTH_URL=http://localhost:3000

# Mismo proyecto Supabase que Nexo — usados para Storage (adjuntos de
# tareas, bucket privado "task-attachments"). Mismos valores que
# nexo/.env.local.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Proveedor de email (opcional). Solo necesaria si un negocio elige "Resend" en Configuración → Email.
# Secreto de plataforma: NO es por tenant. Sin ella, Resend figura como no disponible y el modo prueba sigue funcionando.
RESEND_API_KEY=

# Secreto para proteger los endpoints de cron (app/api/cron/*), invocados por un
# scheduler externo (Vercel Cron, cron-job.org, GitHub Actions, etc.), nunca por el navegador.
# Sin esta variable, esos endpoints devuelven 500 en vez de quedar abiertos.
CRON_SECRET=

# ── Google (Gmail / Calendar) ─────────────────────────────────────────────
# UN solo cliente OAuth de Kodexa para Nexo y Nodo (ver
# nexo/docs/architecture/google-integration.md). Sin estas variables, la
# conexión con Google queda deshabilitada y los emails salen por Resend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI de ESTA app (Nodo); cada app tiene la suya y las dos deben
# estar registradas en el cliente OAuth de Google. Ej: https://<dominio-nodo>/api/integrations/google/callback
GOOGLE_REDIRECT_URI=
# Clave AES-256-GCM (32 bytes en base64) para cifrar el refresh token. DEBE ser
# el MISMO valor en Nexo y Nodo (comparten la tabla GoogleConnection).
# Generar con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=
