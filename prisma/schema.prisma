generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // "nexo" agregado en la Fase 4 (integración Nexo -> Nodo): el CRM
  // necesita LEER nexo.Appointment para sincronizar Leads. Ver
  // modules/nexo/ — es la ÚNICA capa autorizada a usar el modelo
  // `Appointment` de abajo; el resto de la aplicación nunca debe
  // importarlo directo (ver docs/architecture/crm-fase4-nexo-leads.md).
  schemas = ["public", "crm", "nexo"]
}

// ═══════════════════════════════════════════════════════════════════════
// IDENTIDAD Y TENANT COMPARTIDOS (public) — espejo de las tablas físicas
// que ya crea y usa Nexo. Mismas tablas, mismos datos, DOS proyectos
// Prisma independientes declarando el mismo esquema físico — eso es
// exactamente lo que permite "una identidad, dos productos" sin un
// servicio de auth separado. Ver sección B del documento de esta fase.
//
// Decisión explícita: NO se incluye acá un modelo `Lead` (el `public.Lead`
// de Nexo, pipeline comercial de Kodexa) — el CRM no lo necesita en esta
// fase, y declararlo colisionaría de nombre con `crm.Lead` (el prospecto
// propio de cada negocio que usa el CRM, un concepto completamente
// distinto). Documentado en detalle en la Fase 1 y otra vez acá porque es
// el punto de confusión más probable de todo este schema.
// ═══════════════════════════════════════════════════════════════════════

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  memberships   Membership[]
  accounts      Account[]
  sessions      Session[]

  @@map("user")
  @@schema("public")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
  @@schema("public")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
  @@schema("public")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
  @@schema("public")
}

// Espejo deliberadamente incompleto de public.Business: solo se declaran
// los campos que el CRM realmente usa (id/name/timestamps). Los campos
// específicos de Nexo (slug, siteTemplate, deposit*, menu*, etc. — ver
// Fase 3, "Business como entidad compartida") existen físicamente en la
// tabla pero no acá: son nullable o tienen DEFAULT en Postgres, así que un
// INSERT hecho desde el Prisma Client del CRM (ver modules/business en
// esta fase) nunca los necesita. El CRM nunca debe escribirlos ni leerlos
// — no son de su dominio.
model Business {
  id          String       @id @default(cuid())
  name        String
  // Agregado en Fase 3 (CRM Core): columna física ya existente (Nexo la
  // usa para el sitio público) — solo se agrega la declaración de campo al
  // espejo de este proyecto, sin ninguna migración, para que el CRM pueda
  // mostrar el logo del negocio en el Workspace (ver crm-fase3-core.md,
  // "Workspace — nombre y logo"). No se toca nexo/ ni se crea nada nuevo
  // en la base.
  logoUrl     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  workspace   Workspace?

  @@schema("public")
}

// Espejo de public.GoogleConnection (la migración vive en Nexo, dueño del schema
// public — mismo criterio que User/Business). Conexión Google (Gmail/Calendar)
// de un usuario dentro de un negocio: el refresh token se guarda CIFRADO (ver
// lib/google/crypto.ts) y nunca sale del servidor. Relaciones omitidas a
// propósito: las FKs existen físicamente; el CRM solo filtra por businessId +
// userId de la sesión.
model GoogleConnection {
  id              String   @id @default(cuid())
  businessId      String
  userId          String
  googleEmail     String
  refreshTokenEnc String?
  scopes          String[]
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([businessId, userId])
  @@index([businessId])
  @@schema("public")
}

model Membership {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  role       String   @default("owner")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
  @@schema("public")
}

// ═══════════════════════════════════════════════════════════════════════
// CRM — modelos propios de este producto.
//
// Toda tabla de dominio referencia `businessId`, pero la FK real apunta a
// Workspace.businessId (no directo a public.Business) — a propósito: esto
// hace que la base misma exija "no puede existir un Company/Contact/...
// sin que su Business tenga antes un Workspace creado", en vez de confiar
// en que el código de aplicación lo chequee. El nombre de columna sigue
// siendo `businessId` en todos lados por consistencia de lectura/queries
// (mismo criterio que usa nexo.* contra public.Business).
// ═══════════════════════════════════════════════════════════════════════

// Entidad raíz del CRM. Su EXISTENCIA para un businessId es la señal de
// "este negocio usa CRM" — reemplaza una tabla ProductAccess/Entitlement
// formal y compartida (fuera de alcance, ver Fase 1 y el pedido de esta
// fase, punto 9).
model Workspace {
  businessId        String   @id
  industryTemplate  String?
  activeModules     String[]
  onboardingStep    String?
  defaultPipelineId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  companies               Company[]
  contacts                Contact[]
  leads                   Lead[]
  opportunities           Opportunity[]
  tasks                   Task[]
  calendarEvents           CalendarEvent[]
  emailSettings           EmailSettings?
  emailTemplates          EmailTemplate[]
  reminders               Reminder[]
  notifications           Notification[]
  moduleConfigs           ModuleConfig[]
  activities              Activity[]
  pipelines               Pipeline[]
  tags                    Tag[]
  statusDefinitions       StatusDefinition[]
  customFieldDefinitions  CustomFieldDefinition[]

  @@schema("crm")
}

// "Empresa cliente" del negocio que usa el CRM — NO confundir con
// public.Business (el tenant/cliente de Kodexa). El ítem "Clientes" del
// MVP (ver Fase 1, sección 12) se resuelve con `status`, sin un modelo
// aparte: "prospect" mientras se está evaluando, "customer" una vez que
// convirtió.
model Company {
  id         String   @id @default(cuid())
  businessId String
  ownerId    String?
  name       String
  domain     String?
  phone      String?
  status     String   @default("prospect")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workspace     Workspace     @relation(fields: [businessId], references: [businessId], onDelete: Cascade)
  contacts      Contact[]
  leads         Lead[]
  opportunities Opportunity[]
  tasks         Task[]
  calendarEvents CalendarEvent[]

  @@index([businessId])
  @@schema("crm")
}

model Contact {
  id         String   @id @default(cuid())
  businessId String
  ownerId    String?
  companyId  String?
  name       String
  email      String?
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workspace     Workspace     @relation(fields: [businessId], references: [businessId], onDelete: Cascade)
  company       Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  opportunities Opportunity[]
  tasks         Task[]
  calendarEvents CalendarEvent[]
  // Leads que se convirtieron EN este Contact (Fase 5) — array a propósito:
  // "usar contacto existente" permite que más de un Lead termine apuntando
  // al mismo Contact (ver modules/leads/conversion.ts). onDelete: SetNull
  // en el lado del Lead: borrar este Contact nunca borra el Lead histórico.
  convertedFromLeads Lead[] @relation("LeadConvertedContact")

  @@index([businessId])
  @@index([companyId])
  @@schema("crm")
}

// Lead propio del CRM — un prospecto DEL NEGOCIO QUE USA EL CRM. No
// confundir con public.Lead (pipeline comercial de Kodexa/Nexo, un
// concepto de dominio completamente distinto que comparte nombre). Ver
// comentario al principio de este archivo.
model Lead {
  id         String   @id @default(cuid())
  businessId String
  ownerId    String?
  companyId  String?
  name       String
  email      String?
  phone      String?
  status     String   @default("new")
  // "manual" | "nexo_appointment" (Fase 4) | "import" (futuro).
  source     String?  @default("manual")
  // ID del registro de origen en el sistema externo (hoy: nexo.Appointment.id)
  // — null para leads manuales/importados sin origen puntual. Junto con
  // `source`, es la base de la idempotencia de la sincronización con Nexo:
  // @@unique([businessId, source, sourceRef]) hace que reprocesar el MISMO
  // turno nunca cree un segundo Lead. Postgres no considera dos NULL
  // iguales en un unique index, así que los leads manuales (sourceRef null)
  // nunca chocan entre sí por esto. Ver modules/nexo/sync-leads.ts.
  sourceRef  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Conversión (Fase 5 — Lead → Contact → Opportunity). FKs directas, no
  // polimórficas (mismo criterio que Task.companyId/contactId/...) — un
  // Lead se convierte en, a lo sumo, UN Contact y UNA Opportunity, así que
  // no hace falta relatedType/relatedId genérico acá. convertedAt es la
  // fuente de verdad de "¿ya se convirtió?" (no basta con mirar status:
  // ver modules/leads/service.ts, guardas de updateLead). onDelete:
  // SetNull en ambas — borrar el Contact/Opportunity resultante nunca
  // borra el Lead histórico, y borrar el Lead nunca toca el Contact/
  // Opportunity reales (ver docs/architecture/crm-fase5-lead-conversion.md,
  // "Eliminaciones").
  convertedAt           DateTime?
  convertedContactId     String?
  convertedOpportunityId String?  @unique

  workspace           Workspace    @relation(fields: [businessId], references: [businessId], onDelete: Cascade)
  company             Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  tasks               Task[]
  calendarEvents       CalendarEvent[]
  convertedContact     Contact?     @relation("LeadConvertedContact", fields: [convertedContactId], references: [id], onDelete: SetNull)
  convertedOpportunity Opportunity? @relation("LeadConvertedOpportunity", fields: [convertedOpportunityId], references: [id], onDelete: SetNull)

  @@unique([businessId, source, sourceRef])
  @@index([businessId])
  @@index([convertedContactId])
  @@schema("crm")
}

model Pipeline {
  id         String   @id @default(cuid())
  businessId String
  name       String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  workspace     Workspace       @relation(fields: [businessId], references: [businessId], onDelete: Cascade)
  stages        PipelineStage[]
  opportunities Opportunity[]

  @@index([businessId])
  @@schema("crm")
}

model PipelineStage {
  id         String  @id @default(cuid())
  pipelineId String
  key        String
  label      String
  order      Int     @default(0)
  isWon      Boolean @default(false)
  isLost     Boolean @default(false)

  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@unique([pipelineId, key])
  @@schema("crm")
}

model Opportunity {
  id         String    @id @default(cuid())
  businessId String
  ownerId    String?
  companyId  String?
  contactId  String?
  pipelineId String
  stageId    String
  title      String
  amount     Float?
  status     String    @default("open")
  closedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  workspace Workspace     @relation(fields: [businessId], references: [businessId], onDelete: Cascade)
  company   Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact   Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  pipeline  Pipeline      @relation(fields: [pipelineId], references: [id])
  stage     PipelineStage @relation(fields: [stageId], references: [id])
  tasks     Task[]
  calendarEvents CalendarEvent[]
  // Lead que originó esta Opportunity vía conversión (Fase 5) — ?  porque
  // la inmensa mayoría de las Opportunity NO vienen de una conversión
  // (se crean directo). Uno-a-uno real: convertedOpportunityId es @unique
  // del lado del Lead, así que nunca hay dos Leads apuntando a la misma
  // Opportunity.
  convertedFromLead Lead? @relation("LeadConvertedOpportunity")

  @@index([businessId])
  @@schema("crm")
}

// Unidad de trabajo real del CRM (Fase "Tareas v2") — ver
// docs/architecture/crm-fase-tareas.md para el análisis completo.
//
// status/priority: String, NO un enum nativo de Postgres — mismo criterio
// que TODO el resto del proyecto (Nexo y CRM), para no pagar fricción de
// migración por cada valor nuevo. El vocabulario fijo pedido
// (TODO/IN_PROGRESS/COMPLETED/CANCELLED, LOW/MEDIUM/HIGH/URGENT) se valida
// en TypeScript/Zod (ver lib/schemas.ts), no en la base.
//
// ownerId sigue siendo el "responsable" (mismo campo que ya existía y ya
// está en uso — no se renombra). createdById es NUEVO: quien creó la
// tarea, casi siempre distinto de a quién se la asignó.
//
// relatedType/relatedId (genéricos, de un solo relacionado) se
// REEMPLAZAN por 4 FKs explícitas opcionales — mismo patrón que ya usa
// Opportunity (companyId/contactId) — porque una tarea real necesita poder
// relacionarse con MÁS DE UNA entidad a la vez (ej. una Empresa Y una
// Oportunidad en la misma tarea), algo que el polimórfico de a uno no
// podía representar. Se verificó antes de este cambio que la única fila
// real existente tenía ambos campos en null — sin pérdida de datos.
model Task {
  id          String    @id @default(cuid())
  businessId  String
  title       String
  description String?
  status      String    @default("todo")
  priority    String    @default("medium")
  startDate   DateTime?
  dueAt       DateTime?
  completedAt DateTime?
  ownerId     String?
  createdById String?
  companyId     String?
  contactId     String?
  leadId        String?
  opportunityId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace    @relation(fields: [businessId], references: [businessId], onDelete: Cascade)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  attachments TaskAttachment[]
  reminders   Reminder[]
  calendarEvents CalendarEvent[]

  @@index([businessId])
  @@index([businessId, ownerId])
  @@index([companyId])
  @@index([contactId])
  @@index([leadId])
  @@index([opportunityId])
  @@schema("crm")
}

// Metadata únicamente — el binario vive en Supabase Storage (bucket
// privado "task-attachments"), nunca en Postgres. Mismo patrón ya
// probado en Nexo (nexo/lib/payment-proofs.ts): storagePath es la
// referencia real, nunca una URL pública; el acceso siempre pasa por una
// signed URL de corta duración generada bajo demanda (ver
// modules/tasks/attachments.ts).
model TaskAttachment {
  id            String   @id @default(cuid())
  businessId    String
  taskId        String
  fileName      String
  storagePath   String
  mimeType      String
  fileSizeBytes Int
  uploadedById  String?
  createdAt     DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([taskId])
  @@schema("crm")
}

// Polimórfica a propósito (relatedType/relatedId) para no tener una tabla
// de historial por cada entidad — mismo criterio de "un solo choke point"
// que ya usa BusinessNotification en Nexo.
// Evento agendado (reunión/llamada/seguimiento/...). Entidad propia y NO
// una Activity: Activity es un log append-only ("pasó X"), un evento es un
// compromiso futuro editable con inicio/fin, responsable y estado. El
// historial del evento sí va a Activity (ver modules/calendar/service.ts).
// FKs directas nullable (mismo criterio que Task), sin tabla polimórfica.
// Google Calendar (futuro) = tabla CalendarIntegration/externalId aparte,
// sin tocar este modelo.
model CalendarEvent {
  id            String   @id @default(cuid())
  businessId    String
  title         String
  description   String?
  type          String   @default("meeting")
  status        String   @default("scheduled")
  startsAt      DateTime
  endsAt        DateTime
  location      String?
  ownerId       String?
  createdById   String?
  companyId     String?
  contactId     String?
  leadId        String?
  opportunityId String?
  // "internal" (solo Nodo) | "google" (además existe como evento en el Google
  // Calendar principal de googleUserId). Los eventos externos de Google que Nodo
  // solo LEE no se guardan acá: se consultan en vivo.
  provider      String   @default("internal")
  googleEventId String?
  // Usuario cuya cuenta de Google contiene el evento: solo él puede
  // editarlo/eliminarlo en Google (nunca se usa la conexión de otro usuario).
  googleUserId  String?
  // Tarea desde la que se creó con "Agregar a Google Calendar".
  taskId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace   Workspace    @relation(fields: [businessId], references: [businessId], onDelete: Cascade)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)

  // Un evento de Google no puede estar vinculado dos veces en el mismo negocio
  // (los NULL no colisionan: los eventos internos no tienen googleEventId).
  @@unique([businessId, googleEventId])
  @@index([taskId])
  @@index([businessId, startsAt])
  @@index([businessId, ownerId])
  @@index([companyId])
  @@index([contactId])
  @@index([leadId])
  @@index([opportunityId])
  @@schema("crm")
}

// Configuración de remitente por negocio (1:1 con Workspace). La API key
// del proveedor NO vive acá: es un secreto de plataforma (env). Ver
// docs/architecture/crm-email-foundation.md.
model EmailSettings {
  businessId String   @id
  provider   String   @default("sandbox")
  fromEmail  String?
  fromName   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workspace Workspace @relation(fields: [businessId], references: [businessId], onDelete: Cascade)

  @@schema("crm")
}

model EmailTemplate {
  id         String   @id @default(cuid())
  businessId String
  name       String
  subject    String
  bodyHtml   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workspace Workspace @relation(fields: [businessId], references: [businessId], onDelete: Cascade)

  @@unique([businessId, name])
  @@schema("crm")
}

// Recordatorio para un usuario, anclado a una Task o a una Activity (una
// de las dos, nunca ninguna ni ambas — validado en
// modules/reminders/service.ts, no hay constraint de base porque Postgres
// no puede expresar "exactamente una de dos FKs nullable" con un CHECK
// simple sin duplicar lógica). Cascade en ambas FKs: el recordatorio no
// tiene razón de existir sin su tarea/actividad (a diferencia de
// Task.companyId, que usa SetNull porque la Task sí sobrevive sin la
// Company). `userId` es sólo el id (sin relación Prisma a User, mismo
// criterio que Task.ownerId) — el usuario se valida contra Membership.
model Reminder {
  id         String    @id @default(cuid())
  businessId String
  userId     String
  taskId     String?
  activityId String?
  remindAt   DateTime
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  workspace Workspace @relation(fields: [businessId], references: [businessId], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  activity  Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([businessId, status, remindAt])
  @@index([userId])
  @@index([taskId])
  @@index([activityId])
  @@schema("crm")
}

// Notificación interna mínima y reutilizable (no sólo para Recordatorios,
// aunque hoy sea el único emisor) — mismo criterio que
// nexo.BusinessNotification, pero por USUARIO además de por negocio:
// nexo.BusinessNotification es para el dueño del negocio en general, acá
// cada miembro tiene su propia bandeja (ej.: "recordame A a las 13:00"
// sólo le llega a A, no a todo el Workspace).
model Notification {
  id           String    @id @default(cuid())
  businessId   String
  userId       String
  type         String
  title        String
  body         String
  resourceHref String?
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  workspace Workspace @relation(fields: [businessId], references: [businessId], onDelete: Cascade)

  @@index([businessId, userId, readAt])
  @@index([userId, createdAt])
  @@schema("crm")
}

// Nombre visible + ícono configurable por Workspace para un módulo interno
// que YA existe (hoy sólo "opportunity" — ver INTERNAL_MODULES en
// modules/workspace/module-config.ts). Deliberadamente NO tiene un
// campo `enabled`: ese estado ya existe en Workspace.activeModules
// (["companies","contacts",...,"opportunities",...]) y duplicarlo acá
// crearía dos fuentes de verdad que podrían desincronizarse. Fila
// ausente = usar los defaults del template de industria (o el fallback
// genérico "Oportunidad/Oportunidades") — no todo Workspace tiene por
// qué tener una fila acá.
model ModuleConfig {
  id             String   @id @default(cuid())
  businessId     String
  internalModule String
  labelSingular  String
  labelPlural    String
  icon           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace @relation(fields: [businessId], references: [businessId], onDelete: Cascade)

  @@unique([businessId, internalModule])
  @@schema("crm")
}

model Activity {
  id          String   @id @default(cuid())
  businessId  String
  ownerId     String?
  relatedType String
  relatedId   String
  type        String
  body        String?
  createdAt   DateTime @default(now())

  workspace Workspace  @relation(fields: [businessId], references: [businessId], onDelete: Cascade)
  reminders Reminder[]

  @@index([businessId])
  @@index([relatedType, relatedId])
  @@schema("crm")
}

// Estados configurables para entidades que no tienen pipeline propio
// (Lead/Company/Task — Opportunity ya tiene el suyo vía PipelineStage).
// Mismo criterio que TODO el resto de este proyecto (y de Nexo): el campo
// de estado en el modelo de dominio es un String libre, nunca un enum de
// Prisma — esta tabla es el catálogo de valores válidos/etiquetas, no una
// constraint de base.
model StatusDefinition {
  id         String  @id @default(cuid())
  businessId String
  entityType String
  key        String
  label      String
  color      String?
  order      Int     @default(0)
  isDefault  Boolean @default(false)

  workspace Workspace @relation(fields: [businessId], references: [businessId], onDelete: Cascade)

  @@unique([businessId, entityType, key])
  @@schema("crm")
}

// Definición de campo personalizado. Tipos primitivos únicamente en esta
// fase (texto/número/moneda/fecha/fecha-hora/boolean/selección/selección
// múltiple/email/teléfono/URL) — relaciones y archivos quedan post-MVP
// (ver Fase 1, sección 12): ninguno de los dos cabe en un CustomFieldValue
// de texto sin inventar un tipo de dato nuevo sin un caso de uso pedido
// todavía.
model CustomFieldDefinition {
  id         String   @id @default(cuid())
  businessId String
  entityType String
  key        String
  label      String
  type       String
  options    String[]
  required   Boolean  @default(false)
  order      Int      @default(0)

  workspace Workspace          @relation(fields: [businessId], references: [businessId], onDelete: Cascade)
  values    CustomFieldValue[]

  @@unique([businessId, entityType, key])
  @@schema("crm")
}

model CustomFieldValue {
  id           String  @id @default(cuid())
  definitionId String
  entityId     String
  value        String?

  definition CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, entityId])
  @@schema("crm")
}

// Catálogo de etiquetas del negocio.
model Tag {
  id         String  @id @default(cuid())
  businessId String
  name       String
  color      String?

  workspace  Workspace   @relation(fields: [businessId], references: [businessId], onDelete: Cascade)
  entityTags EntityTag[]

  @@unique([businessId, name])
  @@schema("crm")
}

// Asociación polimórfica etiqueta<->entidad — agregada en Fase 3 (Core
// funcional), estaba deliberadamente pospuesta en la Fase 2 ("no construir
// por adelantado el tagging hasta que se conecte a una pantalla real" —
// ver crm-fase2-bootstrap.md). businessId repetido acá a propósito (mismo
// criterio que el resto del schema): permite scopear/aislar sin tener que
// resolver primero el Tag para saber de qué negocio es.
model EntityTag {
  id         String   @id @default(cuid())
  businessId String
  tagId      String
  entityType String
  entityId   String
  createdAt  DateTime @default(now())

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, entityType, entityId])
  @@index([businessId, entityType, entityId])
  @@schema("crm")
}

// ═══════════════════════════════════════════════════════════════════════
// ESPEJO DE SOLO LECTURA DE NEXO (Fase 4 — integración Nexo -> Nodo)
//
// Nexo es el dueño real de esta tabla (schema físico "nexo", migraciones
// del repo de Nexo). Este modelo es una declaración PARCIAL (solo los
// campos que el CRM necesita leer, ver auditoría en
// docs/architecture/crm-fase4-nexo-leads.md) para que el Prisma Client de
// ESTE proyecto pueda consultarla — mismo patrón ya usado para
// public.Business (Fase 2).
//
// CONVENCIÓN, no una restricción que Prisma imponga técnicamente: SOLO
// modules/nexo/*.ts puede importar/usar este modelo. Ningún otro módulo,
// componente o ruta de API debe referenciarlo directo — ver
// modules/nexo/appointments.ts, el único adapter autorizado. El CRM NUNCA
// escribe acá (ni una sola llamada a .create/.update/.delete en todo el
// código de aplicación — los únicos usos de escritura son en tests, para
// crear datos de prueba, documentado explícitamente ahí).
model Appointment {
  id            String   @id
  businessId    String
  serviceName   String
  customerName  String
  customerPhone String
  date          String
  startTime     String
  status        String
  createdAt     DateTime
  updatedAt     DateTime

  @@schema("nexo")
}

// ═══════════════════════════════════════════════════════════════════════
// ESPEJO DE SOLO LECTURA DE NEXO — nexo.Inquiry (consultas del sitio
// público de Nexo). Mismo contrato que `Appointment` de arriba: Nexo es el
// dueño de la tabla (su migración vive en el repo de Nexo, NO se genera
// ninguna acá), declaración parcial, y SOLO modules/nexo/inquiries.ts puede
// usar este modelo. El CRM nunca escribe acá.
// ═══════════════════════════════════════════════════════════════════════
model Inquiry {
  id               String   @id
  businessId       String
  customerName     String
  customerWhatsapp String
  customerEmail    String
  message          String
  status           String
  createdAt        DateTime
  updatedAt        DateTime

  @@schema("nexo")
}
